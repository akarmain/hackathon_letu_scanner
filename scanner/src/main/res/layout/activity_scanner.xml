<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101318">

    <androidx.camera.view.PreviewView
        android:id="@+id/scannerPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/scanner_preview" />

    <View
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:background="@drawable/scanner_frame" />

    <TextView
        android:id="@+id/scannerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC101318"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/scanner_hint"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FA"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/scanner_permission_title"
            android:textColor="#141923"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/scanner_permission_message"
            android:textColor="#566273"
            android:textSize="17sp" />

        <Button
            android:id="@+id/retryPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="@string/scanner_retry_permission"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/openSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/scanner_open_settings"
            android:textAllCaps="false"
            android:textSize="17sp" />
    </LinearLayout>

    <Button
        android:id="@+id/cancelScanButton"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="@string/scanner_cancel"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/manualEntryButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:text="@string/scanner_manual_action"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold" />
</FrameLayout>
