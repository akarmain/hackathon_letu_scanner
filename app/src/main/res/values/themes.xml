<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Hackathon_letu_scanner" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/warehouse_blue</item>
        <item name="colorPrimaryVariant">@color/warehouse_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/warehouse_blue</item>
        <item name="colorSecondaryVariant">@color/warehouse_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/warehouse_screen_background</item>
        <item name="actionBarStyle">@style/WarehouseActionBar</item>
    </style>

    <style name="WarehouseActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">@color/warehouse_blue</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/WarehouseActionBarTitle</item>
    </style>

    <style name="WarehouseActionBarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
