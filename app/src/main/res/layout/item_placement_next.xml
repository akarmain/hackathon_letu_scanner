<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="102dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/placementNextImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_product_image"
        android:contentDescription="@string/product_image_placeholder_description"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_product_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/placementNextName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/warehouse_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/placementNextCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/warehouse_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/placementNextQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/warehouse_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
